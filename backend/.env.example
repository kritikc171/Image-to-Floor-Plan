# Backend environment template. Copy to backend/.env and fill in real values.
# All values are placeholders. Never commit backend/.env.

# Optional: Groq reasoning provider. Leave empty to use the deterministic
# evidence-based fallback (no AI reasoning, no fabricated output).
GROQ_API_KEY=
# Verify current model IDs at https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_RETRIES=2

# Optional novel-view generation provider (disabled by default).
NOVEL_VIEW_ENABLED=false
NOVEL_VIEW_PROVIDER=disabled
NOVEL_VIEW_MAX_ITERATIONS=4

# Image intake limits
MAX_UPLOAD_BYTES=15728640
MAX_IMAGE_PIXELS=4096

# Frontend origin allowed for CORS (development default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Artifact retention (seconds). Artifacts are local, temporary, and deleted after this window.
ARTIFACT_TTL_SECONDS=3600

# Server
HOST=127.0.0.1
PORT=8000
